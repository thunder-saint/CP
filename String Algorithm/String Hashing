const int p1 = 137, p2 = 277;
const int mod1 = 1e9 + 7, mod2 = 1e9 + 9;
const int N = 1e5 + 1;
int pw1[N], pw2[N];

void pre() {
    pw1[0] = pw2[0] = 1;
    for(int i = 1; i < N; i++) {
        pw1[i] = (pw1[i-1] * p1) % mod1;
        pw2[i] = (pw2[i-1] * p2) % mod2;
    }
}

pair<int, int> get_hash(string s) {
    int n = s.size();
    int hs1 = 0, hs2 = 0;
    for(int i = 0; i < n; i++) {
        hs1 = (hs1 + (s[i] * pw1[i])) % mod1;
        hs2 = (hs2 + (s[i] * pw2[i])) % mod2;
    }
    return {hs1, hs2};
}
