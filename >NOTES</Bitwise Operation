# Formulas:
    => (A | B) = (A ⊕ B) + (A & B);   
    => (A ⊕ B) = (A & B) ⊕ (A | B);

    => (A ⊕ (A & B)) = ((A | B) ⊕ B);
                      = (A &~ B);
    => (A ⊕ (A | B)) = ((A & B) ⊕ B);
                      = (B &~ A);

    => (A + B) = (A ⊕ B) + 2 ( A & B);
               = (A | B) + (A & B);

    => (A - B) = (A ⊕ (A & B)) - (A ⊕ (A | B));
               = ((A | B) ⊕ B) - (A ⊕ (A | B));
               = (A ⊕ (A & B)) - ((A & B) ⊕ B);
               = ((A | B) ⊕ B) - ((A & B) ⊕ B);

